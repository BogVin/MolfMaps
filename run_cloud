#!/usr/bin/env bash
# Start MolfMaps inside a Cursor Cloud Agent VM as a single origin.
#
# Why this is not ./run:
#   1. Cloud preview only reaches 0.0.0.0 (not 127.0.0.1:4200).
#   2. Login shells here often put nvm Node v22.22.2 first. Angular CLI 22
#      requires >= v22.22.3, so `ng serve` exits and only FastAPI remains.
#      Opening that API port shows GET / → 404 (no SPA). Locally a newer
#      Node starts Angular, so the same repo looks fine.
#   3. Cursor forwards every listening port. If :8000 (API-only) and :3000
#      (app) are both up, opening :8000 is a 404. Serve SPA+API on :3000 only.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LISTEN_HOST="${LISTEN_HOST:-0.0.0.0}"
APP_PORT="${APP_PORT:-3000}"
# Leftover API-only servers from ./run or a previous run_cloud confuse preview.
STALE_API_PORT="${STALE_API_PORT:-8000}"
APP_PID=""

export NG_CLI_ANALYTICS=false

node_supported() {
  local bin="${1:-node}"
  command -v "${bin}" >/dev/null 2>&1 || return 1
  "${bin}" -e '
    const [maj, min, pat] = process.versions.node.split(".").map(Number);
    const ok =
      (maj === 22 && (min > 22 || (min === 22 && pat >= 3))) ||
      (maj === 24 && min >= 15) ||
      maj >= 26;
    process.exit(ok ? 0 : 1);
  ' >/dev/null 2>&1
}

# nvm's v22.22.2 is on PATH in Cloud login shells but is one patch below
# Angular CLI 22. Prefer /usr/local/bin (v24.15+) or /exec-daemon (v22.23+).
select_supported_node() {
  local bin dir
  if node_supported node; then
    echo "Using Node $(node -v) ($(command -v node))"
    return 0
  fi
  echo "Active Node $(node -v 2>/dev/null || echo 'none') is too old for Angular CLI (need >= v22.22.3)."
  for bin in /usr/local/bin/node /exec-daemon/node; do
    if node_supported "${bin}"; then
      dir="$(dirname "${bin}")"
      export PATH="${dir}:${PATH}"
      hash -r
      echo "Switched to Node $(node -v) (${bin})"
      return 0
    fi
  done
  echo "error: no Node >= v22.22.3 found. Install one, or run: nvm install 22.22.3" >&2
  exit 1
}

free_port() {
  local port="$1"
  if [[ "${port}" -ge 26000 && "${port}" -le 26999 ]]; then
    echo "error: port ${port} is reserved for Cursor Cloud internals" >&2
    exit 1
  fi
  local pids
  pids="$(lsof -tiTCP:"${port}" -sTCP:LISTEN 2>/dev/null || true)"
  if [[ -z "${pids}" ]]; then
    return 0
  fi
  echo "Port ${port} is in use — stopping PID(s): ${pids}"
  # shellcheck disable=SC2086
  kill ${pids} 2>/dev/null || true
  sleep 0.5
  pids="$(lsof -tiTCP:"${port}" -sTCP:LISTEN 2>/dev/null || true)"
  if [[ -n "${pids}" ]]; then
    # shellcheck disable=SC2086
    kill -9 ${pids} 2>/dev/null || true
  fi
}

wait_http() {
  local url="$1"
  local name="$2"
  local needle="${3:-}"
  local attempts="${4:-90}"
  local i body
  for ((i = 1; i <= attempts; i++)); do
    if body="$(curl -sf --max-time 2 "${url}" 2>/dev/null)"; then
      if [[ -z "${needle}" || "${body}" == *"${needle}"* ]]; then
        return 0
      fi
    fi
    sleep 1
  done
  echo "error: ${name} did not become ready at ${url}" >&2
  return 1
}

cleanup() {
  echo ""
  echo "Stopping MolfMaps (cloud)..."
  if [[ -n "${APP_PID}" ]] && kill -0 "${APP_PID}" 2>/dev/null; then
    kill "${APP_PID}" 2>/dev/null || true
    wait "${APP_PID}" 2>/dev/null || true
  fi
  free_port "${APP_PORT}"
  echo "Stopped."
}

trap cleanup EXIT INT TERM

select_supported_node

BACKEND_DIR="${ROOT}/backend"
FRONTEND_DIR="${ROOT}/frontend"
VENV="${BACKEND_DIR}/.venv"
DIST="${FRONTEND_DIR}/dist/frontend/browser"

if [[ ! -d "${VENV}" ]]; then
  echo "Creating backend virtualenv..."
  python3 -m venv "${VENV}"
  # shellcheck disable=SC1091
  source "${VENV}/bin/activate"
  pip install -r "${BACKEND_DIR}/requirements.txt"
else
  # shellcheck disable=SC1091
  source "${VENV}/bin/activate"
fi

if [[ ! -f "${BACKEND_DIR}/.env" ]]; then
  if [[ -f "${BACKEND_DIR}/.env.example" ]]; then
    echo "No backend/.env found — copying from .env.example"
    cp "${BACKEND_DIR}/.env.example" "${BACKEND_DIR}/.env"
  else
    echo "error: backend/.env is missing (and no .env.example to copy)" >&2
    exit 1
  fi
fi

if [[ ! -d "${FRONTEND_DIR}/node_modules" ]]; then
  echo "Installing frontend dependencies..."
  (cd "${FRONTEND_DIR}" && npm ci)
fi

echo "Building Angular app (Node $(node -v))..."
(cd "${FRONTEND_DIR}" && npm run build -- --configuration development)
if [[ ! -f "${DIST}/index.html" ]]; then
  echo "error: Angular build did not produce ${DIST}/index.html" >&2
  exit 1
fi

free_port "${APP_PORT}"
free_port "${STALE_API_PORT}"

echo "Starting MolfMaps (SPA + API) on http://${LISTEN_HOST}:${APP_PORT} ..."
(
  cd "${BACKEND_DIR}"
  exec uvicorn app.main:app --reload --host "${LISTEN_HOST}" --port "${APP_PORT}"
) &
APP_PID=$!

wait_http "http://127.0.0.1:${APP_PORT}/api/session" "API"
wait_http "http://127.0.0.1:${APP_PORT}/" "app" "app-root"

echo ""
echo "MolfMaps is running in Cursor Cloud:"
echo "  App+API: http://127.0.0.1:${APP_PORT}  (bind ${LISTEN_HOST})"
echo ""
echo "Open forwarded port ${APP_PORT} — do not use :${STALE_API_PORT} (API-only 404)."
echo "Press Ctrl+C to stop."

wait
