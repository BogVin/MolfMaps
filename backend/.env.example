# Admin credentials for the MolfMaps login flow.
# Copy this file to backend/.env and fill in real values. NEVER commit backend/.env.

# The single admin username.
ADMIN_USERNAME=admin

# The single admin password.
ADMIN_PASSWORD=change-me

# Signing key for the session cookie. Use a long, random string in production,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=please-change-this-to-a-long-random-string

# Root of the map catalog store (maps.json + maps/ image files, plus annotation
# sidecars in annotations/ and point-of-interest images in poi-images/). Runtime
# state, created on demand and never committed. Defaults to backend/data.
#MAPS_DATA_DIR=backend/data

# Maximum accepted size of an uploaded image, in bytes. Applies to map images and
# to point-of-interest images, which reuse the same upload handling and limits.
# Defaults to 10 MB.
#MAX_MAP_IMAGE_BYTES=10485760

# Maximum number of images attachable to a single point of interest. Defaults to 5.
#MAX_POI_IMAGES=5
