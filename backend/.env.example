# Admin credentials for the MolfMaps login flow.
# Copy this file to backend/.env and fill in real values. NEVER commit backend/.env.

# The single admin username.
ADMIN_USERNAME=admin

# The single admin password.
ADMIN_PASSWORD=change-me

# Signing key for the session cookie. Use a long, random string in production,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=please-change-this-to-a-long-random-string
