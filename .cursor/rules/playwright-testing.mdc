# Playwright Testing Standards

## Overview

Playwright tests verify complete user workflows, API integrations, and system behavior.

**Goals:**
- Test user-centric workflows end-to-end
- Verify API contract and behavior
- Test critical paths and error scenarios
- Ensure responsive design across devices
- Catch integration issues early

## Test Structure

### File Organization

```
tests/
├── config/
│   ├── playwright.config.ts
│   └── test.env
├── fixtures/
│   ├── api-fixtures.ts       # API helpers
│   └── test-data.ts          # Test user/data
├── pages/                    # Page Object Models
│   ├── login.page.ts
│   ├── dashboard.page.ts
│   └── admin.page.ts
├── e2e/                      # User workflow tests
│   ├── authentication.e2e.ts
│   └── user-management.e2e.ts
└── api/                      # API endpoint tests
    ├── users.api.ts
    └── auth.api.ts
```

### Test Naming

**Format:** `{Feature}_{Scenario}_{ExpectedOutcome}`

```typescript
// Good test names
test('User can login with valid credentials', async () => {});
test('Login shows error for invalid password', async () => {});
test('Admin can manage user roles', async () => {});
test('Mobile navigation is accessible via hamburger menu', async () => {});

// Bad test names
test('Login test', async () => {});
test('test1', async () => {});
test('stuff works', async () => {});
```

## Page Object Model Pattern

```typescript
// pages/login.page.ts
import { Page, Locator } from '@playwright/test';

export class LoginPage {
    readonly page: Page;
    readonly emailInput: Locator;
    readonly passwordInput: Locator;
    readonly submitButton: Locator;
    readonly errorMessage: Locator;
    
    constructor(page: Page) {
        this.page = page;
        // Use data-testid when possible (most reliable)
        this.emailInput = page.getByLabel('Email');
        this.passwordInput = page.getByLabel('Password');
        this.submitButton = page.getByRole('button', { name: 'Sign In' });
        this.errorMessage = page.locator('[role="alert"]');
    }
    
    async goto() {
        await this.page.goto('/login');
    }
    
    async login(email: string, password: string) {
        await this.emailInput.fill(email);
        await this.passwordInput.fill(password);
        await this.submitButton.click();
    }
    
    async expectErrorMessage(message: string) {
        await expect(this.errorMessage).toContainText(message);
    }
}
```

## Test Patterns

### Basic E2E Test

```typescript
import { test, expect } from '@playwright/test';
import { LoginPage } from '../pages/login.page';
import { DashboardPage } from '../pages/dashboard.page';

test.describe('User Authentication', () => {
    let loginPage: LoginPage;
    let dashboardPage: DashboardPage;
    
    test.beforeEach(async ({ page }) => {
        loginPage = new LoginPage(page);
        dashboardPage = new DashboardPage(page);
        await loginPage.goto();
    });
    
    test('@p1 User can login with valid credentials', async ({ page }) => {
        await expect(loginPage.emailInput).toBeVisible();

        await loginPage.login('user@example.com', 'password123');

        await expect(dashboardPage.title).toContainText('Dashboard');
        await expect(page).toHaveURL(/\/dashboard/);
    });
    
    test('Login shows error for invalid password', async () => {
        await loginPage.emailInput.fill('user@example.com');

        await loginPage.passwordInput.fill('wrongpassword');
        await loginPage.submitButton.click();

        await loginPage.expectErrorMessage('Invalid credentials');
    });
});
```

### API Testing

```typescript
test('@p1 API returns created user with correct data', async ({ request }) => {
    const newUser = {
        email: 'newuser@example.com',
        firstName: 'John',
        lastName: 'Doe'
    };

    const response = await request.post('/api/v1/users', {
        data: newUser,
        headers: {
            'Authorization': `Bearer ${process.env.API_TOKEN}`
        }
    });

    expect(response.status()).toBe(201);
    const json = await response.json();
    expect(json).toMatchObject({
        email: newUser.email,
        firstName: newUser.firstName,
        lastName: newUser.lastName,
        id: expect.any(Number)
    });
});

test('API returns 400 for invalid email', async ({ request }) => {
    const response = await request.post('/api/v1/users', {
        data: { email: 'invalid-email', firstName: 'John' }
    });
    
    expect(response.status()).toBe(400);
    const json = await response.json();
    expect(json.errors).toContain(expect.stringContaining('email'));
});
```

### Multi-Step Workflows

```typescript
test('@p1 Admin can create user and assign role', async ({ page, request }) => {
    // Step 1: Login as admin
    const loginPage = new LoginPage(page);
    await page.goto('/login');
    await loginPage.login('admin@company.com', 'adminpass');
    
    // Step 2: Navigate to user management
    const adminPage = new AdminPage(page);
    await adminPage.navigateToUsers();
    
    // Step 3: Create user
    await adminPage.createUserForm.fill({
        email: 'newuser@example.com',
        firstName: 'John',
        lastName: 'Doe'
    });
    await adminPage.submitButton.click();
    
    // Step 4: Verify via API
    const users = await request.get('/api/v1/users', {
        headers: {
            'Authorization': `Bearer ${process.env.API_TOKEN}`
        }
    });
    const json = await users.json();
    expect(json.some(u => u.email === 'newuser@example.com')).toBeTruthy();
    
    // Step 5: Assign role
    const userRow = page.locator('[data-testid="user-newuser@example.com"]');
    await userRow.locator('button:has-text("Edit")').click();
    
    const editForm = new UserEditPage(page);
    await editForm.selectRole('Admin');
    await editForm.submitButton.click();
    
    // Step 6: Verify role assigned
    await expect(userRow.locator('[data-testid="role"]')).toContainText('Admin');
});
```

### Error Scenarios

```typescript
test('Handle server error gracefully', async ({ page }) => {
    // Simulate server error
    await page.route('/api/v1/users', route => {
        route.abort('failed');
    });
    
    const form = new CreateUserForm(page);
    await form.goto();
    await form.submit({ email: 'user@example.com' });
    
    // Expect error message
    await expect(page.locator('[role="alert"]')).toContainText(
        'Unable to create user. Please try again.'
    );
    
    // Expect retry button
    await expect(form.retryButton).toBeEnabled();
});
```

### Responsive Testing

```typescript
test('Navigation works on mobile', async ({ page }) => {
    // Set mobile viewport
    await page.setViewportSize({ width: 375, height: 667 });
    
    await page.goto('/');
    
    // Menu should be hidden
    const menu = page.locator('[data-testid="sidebar"]');
    await expect(menu).not.toBeVisible();
    
    // Click hamburger
    const hamburger = page.locator('[data-testid="menu-button"]');
    await hamburger.click();
    
    // Menu should be visible
    await expect(menu).toBeVisible();
});
```

## Best Practices

### Selectors

**Order of preference:**
1. `getByRole()` — Most accessible
2. `getByLabel()` — Form inputs
3. `getByTestId()` — Data attributes
4. `locator()` — CSS selectors

```typescript
// ✅ Good selectors (stable, accessible)
page.getByRole('button', { name: 'Sign In' })
page.getByLabel('Email')
page.locator('[data-testid="user-card"]')

// ❌ Avoid (brittle, fragile)
page.locator('button.btn.btn-primary')  // CSS class changes break test
page.locator('div > div > button')       // HTML structure changes break
page.locator('text=Submit')              // Text may change
```

### Waiting

**Don't use sleep():**
```typescript
// ❌ NEVER
await page.waitForTimeout(2000);  // Flaky, slow

// ✅ Use proper waits
await expect(element).toBeVisible();
await page.waitForFunction(() => condition);
await page.waitForNavigation();
```

### Test Isolation

```typescript
test.describe('User Management', () => {
    test.beforeEach(async ({ page }) => {
        // Fresh state before each test
        // Create test data
        // Clear cache, etc.
    });
    
    test.afterEach(async ({ request }) => {
        // Clean up test data
        await request.delete(`/api/v1/users/${testUserId}`);
    });
    
    test('Test 1', async ({ page }) => {
        // Independent test
    });
    
    test('Test 2', async ({ page }) => {
        // Independent test
        // Does not depend on Test 1
    });
});
```

### Parallel Execution

Tests run in parallel by default:
```bash
# Run in series (slower but deterministic)
npx playwright test --workers=1

# Run in parallel (default)
npx playwright test --workers=4
```

## Fixture Examples

```typescript
// fixtures/test-data.ts
export const testUser = {
    email: 'test@example.com',
    password: 'TestPassword123!',
    firstName: 'Test',
    lastName: 'User'
};

export const adminUser = {
    email: 'admin@example.com',
    password: 'AdminPass123!',
    firstName: 'Admin',
    lastName: 'User',
    role: 'Admin'
};

// fixtures/api-fixtures.ts
export async function createTestUser(request: APIRequestContext, user: any) {
    const response = await request.post('/api/v1/users', {
        data: user,
        headers: {
            'Authorization': `Bearer ${process.env.API_TOKEN}`
        }
    });
    return response.json();
}

export async function deleteTestUser(request: APIRequestContext, userId: number) {
    await request.delete(`/api/v1/users/${userId}`, {
        headers: {
            'Authorization': `Bearer ${process.env.API_TOKEN}`
        }
    });
}
```

## Test Tagging & CI

```typescript
// Tag by priority
test('@p1 Critical user flow', async () => {});  // Always runs
test('@p2 Important feature', async () => {});   // Runs in full suite
test('Nice to have check', async () => {});      // Selective

// Run in CI
// npm run test:e2e        - all tests
// npm run test:e2e:p1     - critical only (fast feedback)
// npm run test:e2e:mobile - mobile responsive tests
```

## Configuration

```typescript
// playwright.config.ts
import { defineConfig, devices } from '@playwright/test';

export default defineConfig({
    testDir: './tests/e2e',
    fullyParallel: true,
    forbidOnly: !!process.env.CI,
    retries: process.env.CI ? 2 : 0,
    workers: process.env.CI ? 1 : undefined,
    
    use: {
        baseURL: process.env.BASE_URL || 'http://localhost:3000',
        trace: 'on-first-retry',
        screenshot: 'only-on-failure',
        video: 'retain-on-failure'
    },
    
    webServer: {
        command: 'npm run dev',
        url: 'http://localhost:3000',
        reuseExistingServer: !process.env.CI
    },
    
    projects: [
        {
            name: 'chromium',
            use: { ...devices['Desktop Chrome'] }
        },
        {
            name: 'mobile',
            use: { ...devices['Pixel 5'] }
        }
    ]
});
```

## Quality Checklist

Every E2E test should:
- [ ] Test complete user workflow
- [ ] Have clear, descriptive name
- [ ] Follow AAA pattern
- [ ] Be independent (no test order dependency)
- [ ] Use reliable selectors
- [ ] Not use arbitrary delays
- [ ] Clean up test data
- [ ] Have proper assertions
- [ ] Document complex steps
- [ ] Include error scenarios

